# ---------------------------------------------------------------
# Електрооблік будинку — змінні середовища застосунку
#
# Для запуску в Docker цей файл НЕ потрібен: використовуйте
#   node docker/init-env.mjs   (створює .env для docker compose, див. README)
#
# Цей файл — для запуску без Docker (npm run dev / Vercel / інший хостинг):
# скопіюйте у .env.local або задайте в налаштуваннях хостингу.
# Значення читаються під час запуску, а не під час збірки.
# НЕ додавайте реальні значення в репозиторій.
# ---------------------------------------------------------------

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable (anon) key — не секретний, доступ обмежено RLS
SUPABASE_ANON_KEY=
# Service role / secret key — ЛИШЕ сервер (реєстрація, rate limiting, прибирання файлів)
SUPABASE_SERVICE_ROLE_KEY=
# Адреса Supabase для браузера, якщо відрізняється від SUPABASE_URL (напр. внутрішня мережа)
# SUPABASE_PUBLIC_URL=

# Публічна адреса застосунку
SITE_URL=http://localhost:3000

# Секрет для щоденної задачі /api/cron/periods. Довгий випадковий рядок.
CRON_SECRET=

# Домен технічних адрес облікових записів квартир (листи на них не надсилаються)
# RESIDENT_LOGIN_DOMAIN=kvartyry.elektrooblik.local

# Контакт адміністратора для звернень щодо персональних даних (сторінка /privacy)
# LEGAL_ADMIN_CONTACT="Іван Іваненко, +380 67 000 00 00, кв. 5"

# 1 — увімкнути сторінку /preview з вигаданими даними у production
# ENABLE_PREVIEW=0

# Для кількох інстансів: стабільний ключ шифрування Server Actions (base64, 32 байти)
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Лише для тестів
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
# PW_CHROMIUM_PATH=/path/to/chrome
