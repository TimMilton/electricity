# =====================================================================
# Електрооблік будинку — налаштування Docker-стека (docker-compose.yml)
#
# Не редагуйте вручну секрети нижче: створіть .env командою
#   node docker/init-env.mjs                     (локально, http://localhost:8080)
#   node docker/init-env.mjs --domain elektro.example.com   (сервер з HTTPS)
# Без Node:
#   docker run --rm -v "$PWD:/w" -w /w node:22-alpine node docker/init-env.mjs
# Файл .env не потрапляє в git і в Docker-образ.
# =====================================================================

# --- Адреса ----------------------------------------------------------------
# Публічна адреса, яку мешканці відкривають у браузері
PUBLIC_URL=http://localhost:8080
# Що слухає шлюз Caddy: ":80" — HTTP; домен (elektro.example.com) — HTTPS з автоматичним сертифікатом
SITE_ADDRESS=:80
# Порти на комп'ютері/сервері. Для домену з HTTPS: HTTP_PORT=80, HTTPS_PORT=443
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Секрети (генеруються автоматично) -------------------------------------
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
CRON_SECRET=
JWT_EXPIRY=3600

# --- Персональні дані ------------------------------------------------------
# Контакт адміністратора для звернень щодо персональних даних (показується
# на сторінці /privacy). Напр.: "Іван Іваненко, +380 67 000 00 00, кв. 5"
LEGAL_ADMIN_CONTACT=

# --- Інше ------------------------------------------------------------------
# 1 — відкрити сторінку /preview з вигаданими даними
ENABLE_PREVIEW=0

# --- Версії образів (змінюйте лише за потреби) -----------------------------
# Якщо якийсь образ не завантажується, візьміть актуальну версію з
# https://github.com/supabase/supabase/blob/master/docker/docker-compose.yml
# SUPABASE_POSTGRES_IMAGE=supabase/postgres:15.8.1.060
# SUPABASE_AUTH_IMAGE=supabase/gotrue:v2.176.1
# POSTGREST_IMAGE=postgrest/postgrest:v12.2.12
# SUPABASE_STORAGE_IMAGE=supabase/storage-api:v1.24.7
# CADDY_IMAGE=caddy:2.10.0-alpine
# ALPINE_IMAGE=alpine:3.22
